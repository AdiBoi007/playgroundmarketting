# Optional canonical domain override. Vercel otherwise uses the project's production URL.
NEXT_PUBLIC_SITE_URL=

# Shared Gmail delivery for waitlist signups and test briefs that join the waitlist.
# Server-only; never use NEXT_PUBLIC_ prefixes.
# Gmail mailbox that created the app password or authorized the OAuth token.
GMAIL_SENDER_EMAIL=

# Owner notification inbox. Set privately in .env.local or Vercel.
# Notifications only; signups receive no automatic email.
WAITLIST_NOTIFY_EMAIL=

# Simpler setup: a dedicated Google App Password created with 2-Step Verification.
# Set privately as Sensitive in Vercel Production and redeploy. Grouping spaces
# are accepted; the value must contain 16 ASCII letters/digits after removal.
# A nonblank value selects SMTP instead of OAuth. Never use your Google password.
GMAIL_APP_PASSWORD=

# Optional Gmail API alternative; required only when GMAIL_APP_PASSWORD is blank.
# Run npm run gmail:connect for the one-time owner authorization described in
# docs/gmail-waitlist.md. It saves the refresh token automatically. Keep all
# actual credentials in .env.local or Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Populated automatically by gmail:connect; manual OAuth setup can also set it.
GOOGLE_REFRESH_TOKEN=
